# Ananta MES API — /etc/systemd/system/mes-api.service
[Unit]
Description=Ananta MES API (Node/Express)
After=network.target

[Service]
Type=simple
User=app
WorkingDirectory=/home/app/mes/server
ExecStart=/usr/local/bin/node dist/src/index.js
Environment=NODE_ENV=production
Restart=always
RestartSec=5
# server/.env (loaded by the app via dotenv) holds DATABASE_URL, JWT_SECRET, etc.

[Install]
WantedBy=multi-user.target
