# Copy to /home/app/mes/server/.env on the app server and fill in real values.
# DB lives on the separate DB server (192.168.10.205).
DATABASE_URL="postgresql://mes_app:CHANGE_ME@192.168.10.205:5432/ananta_mes?schema=public"

PORT=4000
NODE_ENV=production
JWT_SECRET="CHANGE_ME_to_a_long_random_string_min_32_chars"
JWT_EXPIRES_IN="12h"
# Same origin behind nginx; harmless for same-origin requests.
CORS_ORIGIN="http://mes.ananta.com.bd"
